# =============================================================================
# 0. user site-packages 경로를 sys.path 맨 앞에 등록
#    (뒤에 append가 아니라 맨 앞 insert: conda 베이스에 깔린 numpy/protobuf보다
#     이번에 설치하는 호환 버전이 우선 로드되도록)
# =============================================================================
import sys, site
_user_site = site.getusersitepackages()
if _user_site in sys.path:
    sys.path.remove(_user_site)
sys.path.insert(0, _user_site)

# =============================================================================
# 1. tensorflow / numpy / protobuf 버전 호환 설치
#    - tensorflow 2.15는 numpy 2.0 미지원, protobuf도 버전 맞아야 함
#    - import 시도 후 실패하면(미설치든 버전충돌이든) 호환 버전으로 강제 재설치
# =============================================================================
def _ensure_tensorflow():
    try:
        import tensorflow as tf  # noqa: F401
        return
    except Exception as e:
        print(f"tensorflow import 실패 ({type(e).__name__}: {e}) → 호환 버전으로 재설치합니다. (1~2분 소요)")

    import subprocess
    subprocess.run(
        [sys.executable, "-m", "pip", "install", "--user", "-q",
         "tensorflow==2.15.0", "numpy<2.0", "protobuf<5.0"],
        check=True,
    )

    # 방금 설치로 바뀐 패키지를 이번 세션에서 바로 반영하기 위해
    # 이미 캐시된(부분 실패 포함) 모듈들을 전부 지우고 경로 재등록
    for mod_name in list(sys.modules.keys()):
        if mod_name.split(".")[0] in ("tensorflow", "numpy", "google", "keras"):
            del sys.modules[mod_name]

    if _user_site in sys.path:
        sys.path.remove(_user_site)
    sys.path.insert(0, _user_site)

    import tensorflow as tf  # noqa: F401
    print("설치 완료, TensorFlow 버전:", tf.__version__)

_ensure_tensorflow()

# =============================================================================
# 2. MIG 환경에서 반드시 먼저 실행
#
# 주의: CUDA_VISIBLE_DEVICES="0"은 nvidia-smi에 MIG가 4개 보이더라도
#       그중 인덱스 0번 하나만 CUDA/TensorFlow에 노출시킵니다.
#       4개를 모두 쓰려면 "0,1,2,3"으로 바꾸고, 커널을 완전히 재시작한 뒤
#       이 셀을 TensorFlow import보다 먼저 실행해야 합니다.
# =============================================================================
import os
for key in list(os.environ.keys()):
    if key.startswith(("CUDA_", "NVIDIA_", "TF_")):
        os.environ.pop(key, None)
os.environ["CUDA_VISIBLE_DEVICES"] = "0,1,2"

# =============================================================================
# 3. TensorFlow 라이브러리
# =============================================================================
import tensorflow as tf
print("TensorFlow 버전:", tf.__version__)

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Flatten, Conv2D, MaxPooling2D
from tensorflow.keras.callbacks import TensorBoard
import numpy as np
import time
import matplotlib.pyplot as plt

# =============================================================================
# 4. GPU 확인 (CPU 전용 환경에서는 자동으로 CPU 사용)
# =============================================================================
gpus = tf.config.list_physical_devices('GPU')
if gpus:
    try:
        for gpu in gpus:
            tf.config.experimental.set_memory_growth(gpu, True)
        print(f"성공! GPU 잡힘 → {gpus}")
        print(f"GPU 이름: {tf.config.experimental.get_device_details(gpus[0])['device_name']}")
        device_name = '/GPU:0'
    except Exception as e:
        print("GPU 설정 오류:", e)
        device_name = '/CPU:0'
else:
    print("GPU를 못 찾았습니다. CPU로 진행합니다.")
    device_name = '/CPU:0'

# =============================================================================
# 5. CIFAR-10 데이터셋 로드 및 정규화
#    (외부 cs.toronto.edu 대신 사내 Object Storage의 원본 tar.gz에서 로드)
#
#    [수정 사유]
#    tf.keras.utils.get_file(fname="cifar-10-batches-py", untar=True)는
#      (1) 그 이름의 디렉터리가 이미 존재하면 내용이 비어 있어도 다운로드를
#          통째로 건너뛰고 그 경로를 그대로 반환하며,
#      (2) 압축 해제 결과 폴더 이름이 fname과 같다고 가정합니다.
#    이 때문에 이전 실행에서 만들어진 빈 캐시 폴더가 남아 있으면
#    FileNotFoundError: .../cifar-10-batches-py/data_batch_1 이 발생합니다.
#
#    → 압축 파일만 별도 이름으로 받은 뒤 직접 풀고, data_batch_* 파일이
#      실제로 있는 디렉터리를 탐색하는 방식으로 변경했습니다.
# =============================================================================
import pickle
import shutil
import tarfile

CIFAR10_URL = "https://objectstorage.kr-central-2.kakaocloud.com/v1/32ac749f528f41958493b28d9387911c/kubeflow/cifar-10-python.tar.gz"

# keras 기본 캐시 이름(cifar-10-batches-py)과 겹치지 않게 별도 이름 사용
CIFAR10_ARCHIVE_NAME = "cifar-10-python-objectstorage.tar.gz"
CIFAR10_EXTRACT_DIRNAME = "cifar-10-objectstorage-extracted"

EXPECTED_CIFAR10_FILES = [
    "data_batch_1", "data_batch_2", "data_batch_3",
    "data_batch_4", "data_batch_5", "test_batch",
]


def _load_batch(fpath, label_key="labels"):
    with open(fpath, "rb") as f:
        d = pickle.load(f, encoding="bytes")
        d = {k.decode("utf8"): v for k, v in d.items()}
    data = d["data"].reshape(d["data"].shape[0], 3, 32, 32)
    return data, d[label_key]


def _find_cifar10_batches_dir(root_dir):
    """root_dir 이하에서 배치 파일이 모두 들어있는 디렉터리를 찾습니다.

    tar 내부 최상위 폴더 이름이 무엇이든 상관없이 실제 위치를 찾아냅니다.
    """
    if not os.path.isdir(root_dir):
        return None

    for dirpath, _dirnames, filenames in os.walk(root_dir):
        filenames_set = set(filenames)
        if all(fname in filenames_set for fname in EXPECTED_CIFAR10_FILES):
            return dirpath

    return None


def load_cifar10_from_object_storage(url=CIFAR10_URL):
    cache_root = os.path.join(os.path.expanduser("~"), ".keras", "datasets")
    extract_dir = os.path.join(cache_root, CIFAR10_EXTRACT_DIRNAME)

    batches_dir = None

    for attempt in (1, 2):
        # 이미 정상적으로 풀려있으면 재다운로드하지 않음 (캐싱)
        batches_dir = _find_cifar10_batches_dir(extract_dir)
        if batches_dir is not None:
            break

        print(f"[{attempt}차 시도] CIFAR-10 다운로드 및 압축 해제 중...")

        if os.path.exists(extract_dir):
            shutil.rmtree(extract_dir)
        os.makedirs(extract_dir, exist_ok=True)

        archive_path = tf.keras.utils.get_file(
            fname=CIFAR10_ARCHIVE_NAME,
            origin=url,
            untar=False,
            cache_subdir="datasets",
        )

        try:
            with tarfile.open(archive_path) as tar:
                tar.extractall(path=extract_dir)
        except tarfile.TarError as error:
            print(f"압축 해제 실패({error}). 손상된 파일을 지우고 재시도합니다.")
            if os.path.exists(archive_path):
                os.remove(archive_path)
            continue

        batches_dir = _find_cifar10_batches_dir(extract_dir)

        if batches_dir is None:
            # 압축은 풀렸지만 예상한 파일이 없음 → 손상된 다운로드일 수 있으므로 삭제
            if os.path.exists(archive_path):
                os.remove(archive_path)

    if batches_dir is None:
        raise RuntimeError(
            f"CIFAR-10 데이터를 정상적으로 받지 못했습니다: {url}\n"
            f"'{extract_dir}' 이하에서 {EXPECTED_CIFAR10_FILES} 파일을 찾지 못했습니다.\n"
            "네트워크 상태나 원본 파일 구조를 확인해주세요."
        )

    path = batches_dir
    print("CIFAR-10 배치 파일 경로:", path)

    num_train_samples = 50000
    x_train = np.empty((num_train_samples, 3, 32, 32), dtype="uint8")
    y_train = np.empty((num_train_samples,), dtype="uint8")

    for i in range(1, 6):
        fpath = os.path.join(path, f"data_batch_{i}")
        x_train[(i - 1) * 10000 : i * 10000], y_train[(i - 1) * 10000 : i * 10000] = _load_batch(fpath)

    x_test, y_test = _load_batch(os.path.join(path, "test_batch"))

    y_train = np.reshape(y_train, (len(y_train), 1))
    y_test = np.reshape(y_test, (len(y_test), 1))
    x_train = x_train.transpose(0, 2, 3, 1)
    x_test = x_test.transpose(0, 2, 3, 1)
    x_test = x_test.astype(x_train.dtype)
    y_test = np.asarray(y_test).astype(y_train.dtype)

    return (x_train, y_train), (x_test, y_test)


print("CIFAR-10 로드 중 (사내 Object Storage)...")
(X_train, y_train), (X_test, y_test) = load_cifar10_from_object_storage(CIFAR10_URL)
X_train = X_train.astype('float32') / 255.0
X_test  = X_test.astype('float32')  / 255.0

print("X_train:", X_train.shape, "y_train:", y_train.shape)
print("X_test :", X_test.shape,  "y_test :", y_test.shape)

# =============================================================================
# 6. 모델 정의
# =============================================================================
model = Sequential([
    Conv2D(32, (3, 3), activation='relu', padding='same', input_shape=(32, 32, 3)),
    MaxPooling2D((2, 2), padding='same'),
    Conv2D(64, (3, 3), activation='relu', padding='same'),
    MaxPooling2D((2, 2), padding='same'),
    Conv2D(128, (3, 3), activation='relu', padding='same'),
    MaxPooling2D((2, 2), padding='same'),
    Flatten(),
    Dense(128, activation='relu'),
    Dense(10, activation='softmax')
])

model.summary()

# =============================================================================
# 7. 모델 컴파일
# =============================================================================
model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

# =============================================================================
# 8. TensorBoard 설정
# =============================================================================
log_dir = "logs/fit/" + time.strftime("%Y%m%d-%H%M%S")
tensorboard_callback = TensorBoard(log_dir=log_dir, histogram_freq=1)

# =============================================================================
# 9. 학습 (CPU 환경 기준으로 epochs/batch_size 조정)
# =============================================================================
print(f"\n학습 시작! ({device_name})")
start_time = time.time()

with tf.device(device_name):
    history = model.fit(
        X_train, y_train,
        epochs=10,                      # 리소스 문제가 발생하면, CPU 환경 고려해 10 → 5
        batch_size=256,                 # 리소스 문제가 발생하면, CPU 환경 고려해 256 → 128
        validation_data=(X_test, y_test),
        callbacks=[tensorboard_callback],
        verbose=1
    )

end_time = time.time()
print(f"학습 완료! 소요시간: {end_time - start_time:.2f} 초")

# =============================================================================
# 10. 평가 및 결과 출력
# =============================================================================
print("Evaluating model...")
test_loss, test_acc = model.evaluate(X_test, y_test, verbose=2)
print(f"Test accuracy: {test_acc * 100:.2f}%")

# =============================================================================
# 11. 학습 곡선 시각화
# =============================================================================
plt.figure(figsize=(10,4))
plt.subplot(1,2,1)
plt.plot(history.history['loss'], label='train_loss')
plt.plot(history.history['val_loss'], label='val_loss')
plt.title('Loss'); plt.legend(); plt.grid()
plt.subplot(1,2,2)
plt.plot(history.history['accuracy'], label='train_acc')
plt.plot(history.history['val_accuracy'], label='val_acc')
plt.title('Accuracy'); plt.legend(); plt.grid()
plt.tight_layout()
plt.show()

# =============================================================================
# 12. TensorBoard 실행 방법
# =============================================================================
print(f"\nTensorBoard 실행 명령어:")
print(f"tensorboard --logdir {log_dir} --bind_all")
